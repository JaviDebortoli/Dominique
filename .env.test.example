# Copy to .env.test (kept out of git, like .env). See .env.test's own comment
# for why this MUST be a separate named `prisma dev` instance (not just a
# different database name on the same instance — this local Postgres proxy
# does not isolate by dbname).
#
# One-time setup:
#   npx prisma dev --name dominique-test --port 51220 --db-port 51221 \
#     --shadow-db-port 51222 --detach
#   npx prisma dev ls    # confirm the actual TCP port assigned, then use it below
#   npm run db:test:setup
#
# connection_limit=10 etc. match `prisma dev`'s own printed recommendation —
# without them this lightweight local engine can start resetting connections
# under concurrent load (Vitest + Playwright's webServer).
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:51222/template1?sslmode=disable&connection_limit=10&connect_timeout=0&max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0"
