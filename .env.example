# Copy to .env and fill in real values for your environment.
DATABASE_URL="postgresql://dominique:dominique@localhost:5432/dominique?schema=public"

# MercadoPago Checkout Pro (Phase 5 — src/modules/payments/mercadopago.ts).
# Get both values from https://www.mercadopago.com.ar/developers →
# "Tus integraciones" → create/select an application → "Credenciales de
# producción" (or "Credenciales de prueba" for a sandbox test-user account).
# MP_ACCESS_TOKEN: the application's Access Token (server-side secret — never
# expose it to the client). Starts with APP_USR-... (production) or
# TEST-... (sandbox).
MP_ACCESS_TOKEN="TEST-0000000000000000-000000-00000000000000000000000000000000-000000000"
# MP_WEBHOOK_SECRET: the "Clave secreta" shown on the same application's
# webhook/notifications configuration page — used to validate the
# `x-signature` header on every POST /api/webhooks/mercadopago request.
MP_WEBHOOK_SECRET="replace-with-the-webhook-signing-secret-from-tus-integraciones"
# Public base URL used to build MercadoPago back_urls and notification_url.
# Must be a publicly reachable HTTPS URL in production (MP cannot call
# localhost); use an ngrok/tunnel URL for local sandbox testing.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Auth.js (Phase 7 — src/lib/auth.ts, D7: Credentials + bcrypt admin login).
# Signs/encrypts the admin session JWT (next-auth v5 requires AUTH_SECRET at
# runtime). Generate a real one per environment — never reuse the repo's dev
# value or any example below:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-random-32-byte-base64-secret-unique-per-environment"

# Admin login: there is no self-service "forgot password" flow in the MVP.
# `prisma/seed.ts`'s `seedAdminUser()` only ever creates/updates the ONE
# dev-only fixture account documented in that function's comment, and only
# when ADMIN_SEED_EMAIL/ADMIN_SEED_PASSWORD are NOT set — it is a safety net
# for local dev, not how you provision a real admin.
#
# To set or rotate a REAL admin password in any environment:
#   1. Set these two vars, then run `npm run db:seed` (or `tsx prisma/seed.ts`)
#      — seedAdminUser() will bcrypt-hash ADMIN_SEED_PASSWORD and upsert the
#      AdminUser row for ADMIN_SEED_EMAIL instead of creating the dev fixture.
#   2. Or connect directly to Postgres and UPDATE admin_users.password_hash
#      with a bcrypt hash produced by `node -e "console.log(require('bcryptjs').hashSync('NEW_PASSWORD', 12))"`.
#   3. Unset these two vars again afterward so a later `db:seed` run in this
#      environment doesn't silently re-run provisioning.
# ADMIN_SEED_EMAIL="owner@example.com"
# ADMIN_SEED_PASSWORD="choose-a-strong-unique-password"

# Product image uploads (Phase 7 — app/api/admin/upload/route.ts, D8).
# Leave UNSET for local dev: files are written under public/uploads/products
# and served by Next.js itself. In production (deploy/DEPLOY.md), set this to
# the real VPS directory design.md D8 specifies — deploy/nginx.conf serves
# it via `alias` with `default_type application/octet-stream` (no script
# execution), and the app writes new uploads under "$UPLOAD_DIR/products".
# The public URL returned to the browser is always /uploads/products/<name>
# either way; only the on-disk write location changes.
# UPLOAD_DIR="/var/dominique/uploads"
